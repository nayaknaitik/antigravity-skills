{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResilienceAndCircuitBreakerConfig",
  "description": "Standard configuration template for timeouts, retries, circuit breakers, and bulkheads",
  "type": "object",
  "properties": {
    "timeouts": {
      "type": "object",
      "properties": {
        "connect_timeout_ms": { "type": "integer", "default": 500 },
        "request_timeout_ms": { "type": "integer", "default": 2500 },
        "execution_timeout_ms": { "type": "integer", "default": 5000 }
      },
      "required": ["connect_timeout_ms", "request_timeout_ms", "execution_timeout_ms"]
    },
    "retry_policy": {
      "type": "object",
      "properties": {
        "max_attempts": { "type": "integer", "default": 3 },
        "initial_backoff_ms": { "type": "integer", "default": 100 },
        "max_backoff_ms": { "type": "integer", "default": 2000 },
        "backoff_multiplier": { "type": "number", "default": 2.0 },
        "jitter_type": { "type": "string", "enum": ["full", "equal", "decorrelated"], "default": "full" },
        "retryable_status_codes": {
          "type": "array",
          "items": { "type": "integer" },
          "default": [429, 502, 503, 504]
        }
      },
      "required": ["max_attempts", "initial_backoff_ms", "max_backoff_ms", "jitter_type"]
    },
    "circuit_breaker": {
      "type": "object",
      "properties": {
        "sliding_window_type": { "type": "string", "enum": ["COUNT_BASED", "TIME_BASED"], "default": "COUNT_BASED" },
        "sliding_window_size": { "type": "integer", "default": 100 },
        "minimum_number_of_calls": { "type": "integer", "default": 20 },
        "failure_rate_threshold": { "type": "number", "default": 50.0 },
        "slow_call_rate_threshold": { "type": "number", "default": 75.0 },
        "slow_call_duration_threshold_ms": { "type": "integer", "default": 2000 },
        "wait_duration_in_open_state_ms": { "type": "integer", "default": 5000 },
        "permitted_number_of_calls_in_half_open_state": { "type": "integer", "default": 5 }
      },
      "required": ["sliding_window_size", "failure_rate_threshold", "wait_duration_in_open_state_ms"]
    },
    "bulkhead": {
      "type": "object",
      "properties": {
        "max_concurrent_calls": { "type": "integer", "default": 50 },
        "max_wait_duration_ms": { "type": "integer", "default": 500 }
      },
      "required": ["max_concurrent_calls"]
    }
  },
  "required": ["timeouts", "retry_policy", "circuit_breaker", "bulkhead"]
}
